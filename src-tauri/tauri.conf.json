{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poe-tool",
  "version": "1.4.0",
  "identifier": "com.poetool.desktop",
  "build": {
    "beforeDevCommand": "npm run client",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "POE_tool - 流亡黯道即時查價與資產管理",
        "width": 1240,
        "height": 860,
        "minWidth": 850,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
