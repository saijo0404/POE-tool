{
  "name": "poe-tool",
  "version": "2.6.0",
  "description": "Path of Exile (PoE) 繁體中文即時查價、倉庫資產追蹤與 Build 造價計算工具",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "path-of-exile",
    "poe",
    "price-checker",
    "wealth-tracker",
    "build-calculator",
    "traditional-chinese",
    "taiwan",
    "international",
    "tauri",
    "rust"
  ],
  "scripts": {
    "dev": "vite",
    "client": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "tauri:dev": "LIBGL_ALWAYS_SOFTWARE=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "tauri:build": "npm run build && tauri build",
    "tauri:build:win": "npm run build && tauri build --target x86_64-pc-windows-msvc --runner cargo-xwin --no-bundle",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.1.0",
    "@tauri-apps/plugin-shell": "^2.1.0",
    "axios": "^1.19.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.0.7"
  }
}
